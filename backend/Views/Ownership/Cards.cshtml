@model List<backend.Models.Ownership>

@{
    ViewData["Title"] = "Sohbet Kartlarım";
}

<div class="min-h-[calc(100vh-73px)] bg-gray-50">
    <div class="max-w-6xl mx-auto p-8">
        <div class="mb-6 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="/Account/Profile" class="p-2 hover:bg-gray-200 rounded-full transition-colors">
                    <i data-lucide="chevron-left" class="w-5 h-5"></i>
                </a>
                <h1 class="text-2xl font-bold">Sahiplik Kartlarım</h1>
            </div>
            <a href="/Listings/Index" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white h-10 px-4 py-2">
                <i data-lucide="plus" class="w-4 h-4 mr-2"></i>
                Hayvan Ekle
            </a>
        </div>

        @if (Model.Any())
        {
            <div class="grid md:grid-cols-2 gap-6">
                @foreach (var pet in Model)
                {
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden border">
                        <div class="bg-gradient-to-r from-blue-600 to-purple-600 p-4 text-white flex justify-between items-center">
                            <div class="flex items-center gap-3">
                                <i data-lucide="shield-check" class="w-6 h-6"></i>
                                <span class="font-semibold tracking-wide">RESMİ SAHİPLİK KARTI</span>
                            </div>
                            <span class="text-xs bg-white/20 px-2 py-1 rounded">No: @pet.Id.ToString("D6")</span>
                        </div>
                        
                        <div class="p-6">
                            <div class="flex gap-6">
                                <!-- Photo -->
                                <div class="w-1/3">
                                    <div class="aspect-square rounded-lg overflow-hidden border-4 border-gray-100 shadow-sm mb-2">
                                        <img src="@pet.PetImage" alt="@pet.PetName" class="w-full h-full object-cover" />
                                    </div>
                                    <div class="text-center">
                                        <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full font-semibold">
                                            @pet.PetType
                                        </span>
                                    </div>
                                </div>
                                
                                <!-- Info -->
                                <div class="w-2/3 space-y-4">
                                    <div>
                                        <h2 class="text-2xl font-bold text-gray-900">@pet.PetName</h2>
                                        <p class="text-gray-500 text-sm">@pet.Breed</p>
                                    </div>
                                    
                                    <div class="grid grid-cols-2 gap-2 text-sm">
                                        <div>
                                            <p class="text-gray-400 text-xs">Yaş</p>
                                            <p class="font-medium">@pet.Age</p>
                                        </div>
                                        <div>
                                            <p class="text-gray-400 text-xs">Cinsiyet</p>
                                            <p class="font-medium">-</p>
                                        </div>
                                        <div>
                                            <p class="text-gray-400 text-xs">Şehir</p>
                                            <p class="font-medium">@pet.City</p>
                                        </div>
                                        <div>
                                            <p class="text-gray-400 text-xs">Sahibi</p>
                                            <p class="font-medium">@pet.OwnerName</p>
                                        </div>
                                    </div>

                                    <div class="pt-4 border-t flex justify-between items-end">
                                        <div>
                                            <p class="text-gray-400 text-xs">Sahiplenme Tarihi</p>
                                            <p class="font-medium">@pet.AdoptionDate.ToShortDateString()</p>
                                        </div>
                                        <!-- QR Code -->
                                        <div class="w-16 h-16 bg-gray-100 rounded p-1">
                                            <img src="@pet.QrCodeImage" alt="QR Code" class="w-full h-full" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="bg-gray-50 px-6 py-3 border-t text-xs text-gray-500 flex justify-between">
                            <span>PetAdopt verified</span>
                            <span>petadopt.com/verify/@pet.Id</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-lg border shadow-sm p-6 text-center py-12">
                <div class="mx-auto mb-4 w-12 h-12 flex items-center justify-center rounded-full bg-gray-100">
                    <i data-lucide="package-plus" class="w-6 h-6 text-gray-400"></i>
                </div>
                <p class="text-gray-500 mb-4">Henüz sahiplendiğiniz bir hayvan bulunmuyor.</p>
                <a href="/Listings/Index" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white h-10 px-4 py-2">
                    <i data-lucide="search" class="w-4 h-4 mr-2"></i>
                    İlanlara Göz At
                </a>
            </div>
        }
    </div>
</div>
