@model backend.Models.Conversation
@using System.Text.Json

@{
    ViewData["Title"] = "Sohbet - " + (Model.BuyerId == int.Parse(Context.Session.GetString("UserId") ?? "0") ? Model.Seller?.Name : Model.Buyer?.Name);
    var currentUserId = int.Parse(Context.Session.GetString("UserId") ?? "0");
    var otherUser = Model.BuyerId == currentUserId ? Model.Seller : Model.Buyer;
    var otherUserName = otherUser?.Name ?? "Kullanıcı";
    
    List<string> images = new List<string>();
    if (!string.IsNullOrEmpty(Model.Listing?.ImagesJson))
    {
        try { images = JsonSerializer.Deserialize<List<string>>(Model.Listing.ImagesJson) ?? new List<string>(); } catch {}
    }
    var petImage = images.FirstOrDefault() ?? "https://via.placeholder.com/150";
    var petName = Model.Listing?.Name ?? "İlan";
    var petType = Model.Listing?.Type ?? "Hayvan";
}

<!-- Lucide Icons -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="h-[calc(100vh-74px)] bg-gray-50 flex flex-col">
    <!-- Chat Header -->
    <div class="bg-white border-b px-6 py-4 flex items-center justify-between shadow-sm flex-shrink-0">
        <div class="flex items-center gap-4">
            <a href="/Messages" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                <i data-lucide="arrow-left" class="w-5 h-5 text-gray-600"></i>
            </a>
            <div class="flex items-center gap-3">
                <img src="@petImage" alt="@petName" class="w-10 h-10 rounded-full object-cover border" />
                <div>
                    <h2 class="font-semibold text-gray-900">@otherUserName</h2>
                    <p class="text-xs text-gray-500">
                        <span class="font-medium text-blue-600">@petName</span> (@petType) ile ilgileniyor
                    </p>
                </div>
            </div>
        </div>
        <button class="p-2 hover:bg-gray-100 rounded-full text-gray-500">
            <i data-lucide="more-vertical" class="w-5 h-5"></i>
        </button>
    </div>

    <!-- Messages Area -->
    <div id="messages-container" class="flex-1 overflow-y-auto p-6 space-y-4">
        @foreach (var msg in Model.Messages.OrderBy(m => m.Timestamp))
        {
             var isMe = msg.SenderId == currentUserId;
            <div class="flex @(isMe ? "justify-end" : "justify-start")">
                <div class="max-w-[80%] rounded-2xl px-4 py-2 @(isMe ? "bg-blue-600 text-white rounded-tr-none" : "bg-white border text-gray-800 rounded-tl-none shadow-sm")">
                    <p>@msg.Text</p>
                    <p class="text-[10px] @(isMe ? "text-blue-100" : "text-gray-400") mt-1 text-right">
                        @msg.Timestamp.ToLocalTime().ToString("HH:mm")
                    </p>
                </div>
            </div>
        }
    </div>

    <!-- Input Area -->
    <div class="bg-white border-t p-4 flex-shrink-0">
        <div class="max-w-4xl mx-auto flex items-end gap-2">
            <button class="p-2 hover:bg-gray-100 rounded-full text-gray-400 mb-1">
                <i data-lucide="paperclip" class="w-5 h-5"></i>
            </button>
            <div class="flex-1 bg-gray-100 rounded-3xl px-4 py-2 focus-within:ring-2 focus-within:ring-blue-500 focus-within:bg-white transition-all">
                <textarea id="messageInput"
                          rows="1"
                          placeholder="Bir mesaj yazın..."
                          class="w-full bg-transparent border-0 focus:ring-0 resize-none p-1 max-h-32 text-gray-800 placeholder-gray-500 outline-none"
                          oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"></textarea>
            </div>
            <button onclick="send()" class="p-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full transition-colors mb-1 shadow-md">
                <i data-lucide="send" class="w-4 h-4"></i>
            </button>
        </div>
    </div>
</div>

<script>
    lucide.createIcons();
    const conversationId = @Model.Id;
    const messagesContainer = document.getElementById('messages-container');

    // Scroll to bottom
    messagesContainer.scrollTop = messagesContainer.scrollHeight;

    // Send Message
    async function send() {
        const input = document.getElementById('messageInput');
        const text = input.value.trim();
        if (!text) return;

        // Optimistic UI update
        appendMessage(text, 'me');
        input.value = '';
        input.style.height = 'auto';

        try {
            const response = await fetch('/Messages/SendMessage?conversationId=' + conversationId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: text })
            });

            if (!response.ok) throw new Error('Failed to send');

        } catch (error) {
            console.error(error);
            alert('Mesaj gönderilemedi.');
        }
    }

    // Handle Enter key
    document.getElementById('messageInput').addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            send();
        }
    });

    function appendMessage(text, sender) {
        const div = document.createElement('div');
        div.className = `flex ${sender === 'me' ? 'justify-end' : 'justify-start'}`;
        
        const time = new Date().toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });
        
        div.innerHTML = `
            <div class="max-w-[80%] rounded-2xl px-4 py-2 ${sender === 'me' ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-white border text-gray-800 rounded-tl-none shadow-sm'}">
                <p>${text}</p>
                <p class="text-[10px] ${sender === 'me' ? 'text-blue-100' : 'text-gray-400'} mt-1 text-right">
                    ${time}
                </p>
            </div>
        `;
        messagesContainer.appendChild(div);
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }
</script>
