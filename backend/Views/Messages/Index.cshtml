@model List<backend.Models.Conversation>
@using System.Text.Json
@{
    ViewData["Title"] = "Mesajlar";
    var currentUserId = int.Parse(Context.Session.GetString("UserId") ?? "0");
}

<div class="min-h-[calc(100vh-73px)] bg-gray-50 py-8">
    <div class="max-w-4xl mx-auto px-4">
        <h1 class="text-2xl font-bold mb-6 text-gray-900">Mesajlar</h1>

        <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
            @if (Model.Any())
            {
                <div class="divide-y">
                    @foreach (var conversation in Model)
                    {
                        var otherUser = conversation.BuyerId == currentUserId ? conversation.Seller : conversation.Buyer;
                        var lastMessage = conversation.Messages.OrderByDescending(m => m.Timestamp).FirstOrDefault();
                        var unreadCount = conversation.Messages.Count(m => m.SenderId != currentUserId && !m.IsRead);
                        
                        List<string> images = new List<string>();
                        if (!string.IsNullOrEmpty(conversation.Listing?.ImagesJson))
                        {
                            try { images = JsonSerializer.Deserialize<List<string>>(conversation.Listing.ImagesJson) ?? new List<string>(); } catch {}
                        }
                        var petImage = images.FirstOrDefault() ?? "https://via.placeholder.com/150";

                        <a href="/Messages/Chat/@conversation.Id" class="block hover:bg-gray-50 transition-colors p-4">
                            <div class="flex items-center gap-4">
                                <div class="relative">
                                    <div class="w-12 h-12 rounded-full overflow-hidden border border-gray-200">
                                         <img src="@petImage" alt="@conversation.Listing?.Name" class="w-full h-full object-cover" />
                                    </div>
                                    @if (unreadCount > 0)
                                    {
                                        <div class="absolute -top-1 -right-1 bg-red-600 text-white text-xs w-5 h-5 flex items-center justify-center rounded-full border-2 border-white font-bold">
                                            @unreadCount
                                        </div>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-1">
                                        <h3 class="font-semibold text-gray-900 truncate">@(otherUser?.Name ?? "Kullanıcı")</h3>
                                        @if(lastMessage != null)
                                        {
                                            <span class="text-xs text-gray-500 whitespace-nowrap">@lastMessage.Timestamp.ToLocalTime().ToString("dd.MM HH:mm")</span>
                                        }
                                    </div>
                                    <p class="text-sm text-gray-500 flex items-center gap-2">
                                        <span class="font-medium text-blue-600">@conversation.Listing?.Name</span>
                                        <span>•</span>
                                        <span class="truncate text-gray-600">@(lastMessage?.Text ?? "Henüz mesaj yok")</span>
                                    </p>
                                </div>
                                <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                         <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">Henüz mesajınız yok</h3>
                    <p class="text-gray-500">
                        İlan sahipleriyle iletişime geçmek için bir ilana gidin ve "Mesaj Gönder" butonuna tıklayın.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
