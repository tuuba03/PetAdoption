@model List<backend.Models.Conversation>

@{
    ViewData["Title"] = "Mesajlar";
}

<div class="min-h-[calc(100vh-73px)] bg-gray-50">
    <div class="max-w-4xl mx-auto p-8">
        <h1 class="text-2xl font-bold mb-6">Mesajlar</h1>

        <div class="bg-white rounded-xl border shadow-sm overflow-hidden">
            @if (Model.Any())
            {
                <div class="divide-y">
                    @foreach (var conversation in Model)
                    {
                        <a href="/Messages/Chat?id=@conversation.Id" class="block hover:bg-gray-50 transition-colors p-4">
                            <div class="flex items-center gap-4">
                                <div class="relative">
                                    <img src="@conversation.PetImage" alt="@conversation.PetName" class="w-12 h-12 rounded-full object-cover" />
                                    @if (conversation.UnreadCount > 0)
                                    {
                                        <div class="absolute -top-1 -right-1 bg-blue-600 text-white text-xs w-5 h-5 flex items-center justify-center rounded-full border-2 border-white">
                                            @conversation.UnreadCount
                                        </div>
                                    }
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between mb-1">
                                        <h3 class="font-semibold text-gray-900 truncate">@conversation.OtherUserName</h3>
                                        <span class="text-xs text-gray-500 whitespace-nowrap">@conversation.LastMessageTime</span>
                                    </div>
                                    <p class="text-sm text-gray-500 flex items-center gap-2">
                                        <span class="font-medium text-gray-700">@conversation.PetName</span>
                                        <span>•</span>
                                        <span class="truncate">@conversation.LastMessage</span>
                                    </p>
                                </div>
                                <i data-lucide="chevron-right" class="w-5 h-5 text-gray-300"></i>
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                         <i data-lucide="message-square" class="w-8 h-8 text-gray-400"></i>
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 mb-2">Henüz mesajınız yok</h3>
                    <p class="text-gray-500">
                        İlan sahipleriyle iletişime geçmek için bir ilana gidin ve "Mesaj Gönder" butonuna tıklayın.
                    </p>
                </div>
            }
        </div>
    </div>
</div>
