@model backend.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Hesap Bilgileri";
}

<div class="min-h-[calc(100vh-73px)]">
    <div class="max-w-3xl mx-auto p-4 md:p-8">
        <!-- Header -->
        <div class="mb-6 flex items-center gap-4">
            <button onclick="history.back()" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                <i data-lucide="chevron-left" class="w-5 h-5"></i>
            </button>
            <h1 class="text-2xl font-bold">Hesap Bilgileri</h1>
        </div>

        <!-- Card -->
        <div class="bg-white rounded-lg border shadow-sm">
            <div class="flex flex-col space-y-1.5 p-6 border-b">
                <h3 class="text-2xl font-semibold leading-none tracking-tight">Profil Bilgileri</h3>
            </div>
            <div class="p-6 space-y-6">
                
                <!-- Avatar -->
                <div class="flex justify-center mb-4">
                    <div class="w-24 h-24 rounded-full bg-gradient-to-r from-blue-600 to-purple-600 flex items-center justify-center">
                        <i data-lucide="user" class="w-12 h-12 text-white"></i>
                    </div>
                </div>

                <!-- Form -->
                <form id="profileForm" class="space-y-4">
                    <div class="space-y-2">
                        <label for="name" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Ad Soyad</label>
                        <div class="relative">
                            <i data-lucide="user" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"></i>
                            <input type="text" id="name" name="name" value="@Model.Name" disabled
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 pl-10" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="email" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">E-posta</label>
                        <div class="relative">
                            <i data-lucide="mail" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"></i>
                            <input type="email" id="email" name="email" value="@Model.Email" disabled
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 pl-10" />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label for="phone" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Telefon</label>
                        <div class="relative">
                            <i data-lucide="phone" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"></i>
                            <input type="tel" id="phone" name="phone" value="@Model.Phone" disabled
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 pl-10" />
                        </div>
                    </div>
                </form>

                <div class="h-[1px] w-full bg-gray-200 my-4"></div>

                <div class="flex gap-3">
                    <button id="btnEdit" onclick="toggleEdit(true)" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 w-full">
                        Düzenle
                    </button>

                    <div id="editActions" class="hidden flex gap-3 w-full">
                        <button onclick="cancelEdit()" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2 flex-1">
                            İptal
                        </button>
                        <button onclick="saveProfile()" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white h-10 px-4 py-2 flex-1">
                            <i data-lucide="save" class="w-4 h-4 mr-2"></i>
                            Kaydet
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const initialData = {
            name: "@Model.Name",
            email: "@Model.Email",
            phone: "@Model.Phone"
        };

        function toggleEdit(isEditing) {
            const inputs = document.querySelectorAll('#profileForm input');
            inputs.forEach(input => input.disabled = !isEditing);

            const btnEdit = document.getElementById('btnEdit');
            const editActions = document.getElementById('editActions');

            if (isEditing) {
                btnEdit.classList.add('hidden');
                editActions.classList.remove('hidden');
                editActions.classList.add('flex');
                document.getElementById('name').focus();
            } else {
                btnEdit.classList.remove('hidden');
                editActions.classList.add('hidden');
                editActions.classList.remove('flex');
            }
        }

        function cancelEdit() {
            // Revert changes
            document.getElementById('name').value = initialData.name;
            document.getElementById('email').value = initialData.email;
            document.getElementById('phone').value = initialData.phone;
            
            toggleEdit(false);
        }

        async function saveProfile() {
            const data = {
                name: document.getElementById('name').value,
                email: document.getElementById('email').value,
                phone: document.getElementById('phone').value
            };

            try {
                const response = await fetch('/Account/Update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    
                    // Update initial data
                    initialData.name = data.name;
                    initialData.email = data.email;
                    initialData.phone = data.phone;

                    toggleEdit(false);
                } else {
                    alert('Bir hata oluştu: ' + result.message);
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Kaydetme sırasında bir hata oluştu.');
            }
        }
    </script>
}
