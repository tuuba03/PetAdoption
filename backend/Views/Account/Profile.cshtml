@model backend.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Profilim";
}

<div class="min-h-[calc(100vh-73px)] bg-gray-50 py-8">
    <div class="max-w-3xl mx-auto px-4">
        <div class="flex items-center gap-4 mb-6">
            <a href="/Home/Dashboard" class="p-2 hover:bg-white rounded-full transition">
                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Hesap Bilgileri</h1>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border p-8">
            <h2 class="font-semibold text-gray-900 mb-8">Profil Bilgileri</h2>

            <div class="flex flex-col items-center mb-8">
                <div class="w-24 h-24 bg-gradient-to-tr from-blue-600 to-purple-600 rounded-full flex items-center justify-center text-white text-3xl font-bold shadow-lg mb-4">
                    @(Model.Name.Length > 0 ? Model.Name.Substring(0, 1).ToUpper() : "U")
                </div>
            </div>

            <form id="profileForm" class="space-y-6 max-w-xl mx-auto">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Ad Soyad</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <input type="text" id="Name" value="@Model.Name" disabled 
                               class="pl-10 block w-full rounded-lg border-gray-300 bg-gray-50 text-gray-500 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5 border" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">E-posta</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <input type="email" id="Email" value="@Model.Email" disabled
                               class="pl-10 block w-full rounded-lg border-gray-300 bg-gray-50 text-gray-500 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5 border" />
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Telefon</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        </div>
                        <input type="tel" id="Phone" value="@Model.Phone" disabled
                               class="pl-10 block w-full rounded-lg border-gray-300 bg-gray-50 text-gray-500 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm py-2.5 border" />
                    </div>
                </div>

                <div class="pt-4 flex gap-3" id="actionButtons">
                    <button type="button" id="editBtn" onclick="toggleEdit()" 
                            class="w-full bg-white border border-gray-300 text-gray-700 py-2.5 rounded-lg hover:bg-gray-50 transition font-medium shadow-sm">
                        Düzenle
                    </button>
                    <button type="button" id="cancelBtn" onclick="cancelEdit()" style="display:none"
                            class="w-1/3 bg-white border border-gray-300 text-gray-700 py-2.5 rounded-lg hover:bg-gray-50 transition font-medium shadow-sm">
                        İptal
                    </button>
                    <button type="submit" id="saveBtn" style="display:none"
                            class="w-2/3 bg-gradient-to-r from-blue-600 to-purple-600 text-white py-2.5 rounded-lg hover:opacity-90 transition font-medium shadow-sm">
                        Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let isEditing = false;
    const initialData = {
        Name: "@Model.Name",
        Email: "@Model.Email",
        Phone: "@Model.Phone"
    };

    function toggleEdit() {
        isEditing = true;
        const inputs = document.querySelectorAll('input');
        inputs.forEach(input => {
            input.disabled = false;
            input.classList.remove('bg-gray-50', 'text-gray-500');
            input.classList.add('bg-white', 'text-gray-900');
        });

        document.getElementById('editBtn').style.display = 'none';
        document.getElementById('cancelBtn').style.display = 'block';
        document.getElementById('saveBtn').style.display = 'block';
        document.getElementById('Name').focus();
    }

    function cancelEdit() {
        isEditing = false;
        const inputs = document.querySelectorAll('input');
        
        // Reset values
        document.getElementById('Name').value = initialData.Name;
        document.getElementById('Email').value = initialData.Email;
        document.getElementById('Phone').value = initialData.Phone;

        inputs.forEach(input => {
            input.disabled = true;
            input.classList.add('bg-gray-50', 'text-gray-500');
            input.classList.remove('bg-white', 'text-gray-900');
        });

        document.getElementById('editBtn').style.display = 'block';
        document.getElementById('cancelBtn').style.display = 'none';
        document.getElementById('saveBtn').style.display = 'none';
    }

    document.getElementById('profileForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const saveBtn = document.getElementById('saveBtn');
        const originalText = saveBtn.innerText;
        saveBtn.innerText = 'Kaydediliyor...';
        saveBtn.disabled = true;

        const data = {
            Name: document.getElementById('Name').value,
            Email: document.getElementById('Email').value,
            Phone: document.getElementById('Phone').value
        };

        try {
            const response = await fetch('/Account/Update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok) {
                // Update initial data
                initialData.Name = data.Name;
                initialData.Email = data.Email;
                initialData.Phone = data.Phone;
                
                alert(result.message);
                cancelEdit(); // Switch back to view mode with new data
                
                // Update avatar initial if name changed (optional, reload page for full update)
                // location.reload(); 
            } else {
                alert(result.message || 'Bir hata oluştu.');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Bir iletişim hatası oluştu.');
        } finally {
            saveBtn.innerText = originalText;
            saveBtn.disabled = false;
        }
    });
</script>
